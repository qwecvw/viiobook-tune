#!/usr/bin/env python3
"""Keyboard backlight auto-off: switch it off after N seconds without keyboard/mouse input
(X11 idle time) and bring the previous level back on the next input.

  kbd-idle [seconds]     default 300

Runs in the user session (XFCE autostart). Brightness goes through UPower's KbdBacklight
D-Bus interface, so no root is needed.
"""
import ctypes as C
import subprocess
import sys
import time

TIMEOUT_MS = (int(sys.argv[1]) if len(sys.argv) > 1 else 300) * 1000


class XScreenSaverInfo(C.Structure):
    _fields_ = [("window", C.c_ulong), ("state", C.c_int), ("kind", C.c_int),
                ("til_or_since", C.c_ulong), ("idle", C.c_ulong), ("event_mask", C.c_ulong)]


x11 = C.CDLL("libX11.so.6")
xss = C.CDLL("libXss.so.1")
x11.XOpenDisplay.restype = C.c_void_p
x11.XOpenDisplay.argtypes = [C.c_char_p]
x11.XDefaultRootWindow.restype = C.c_ulong
x11.XDefaultRootWindow.argtypes = [C.c_void_p]
xss.XScreenSaverAllocInfo.restype = C.POINTER(XScreenSaverInfo)
xss.XScreenSaverQueryInfo.argtypes = [C.c_void_p, C.c_ulong, C.POINTER(XScreenSaverInfo)]

display = x11.XOpenDisplay(None)
if not display:
    sys.exit("kbd-idle: no X display")
root = x11.XDefaultRootWindow(display)
info = xss.XScreenSaverAllocInfo()


def idle_ms():
    xss.XScreenSaverQueryInfo(display, root, info)
    return info.contents.idle


def kbd(method, *args):
    """Call org.freedesktop.UPower.KbdBacklight.<method>; returns the int result or None."""
    out = subprocess.run(
        ["gdbus", "call", "--system", "--dest", "org.freedesktop.UPower",
         "--object-path", "/org/freedesktop/UPower/KbdBacklight",
         "--method", f"org.freedesktop.UPower.KbdBacklight.{method}", *map(str, args)],
        capture_output=True, text=True).stdout.strip()  # "(2,)" or "()"
    digits = out.strip("(),")
    return int(digits) if digits.isdigit() else None


saved = None  # level before we switched it off; None = not dimmed by us
while True:
    idle = idle_ms()
    if saved is None and idle >= TIMEOUT_MS:
        level = kbd("GetBrightness")
        if level:  # already off: nothing to remember
            saved = level
            kbd("SetBrightness", 0)
    elif saved is not None and idle < 2000:
        kbd("SetBrightness", saved)
        saved = None
    time.sleep(0.5 if saved is not None else 5)  # react to input fast only while dimmed
