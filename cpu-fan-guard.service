[Unit]
Description=cpu-menu fan guard (full fan speed above a CPU temperature in user mode)

[Service]
ExecStart=/usr/local/bin/cpu-fan-guard
ExecStopPost=/bin/sh -c 'for h in /sys/class/hwmon/hwmon*; do [ "$(cat $h/name)" = asus ] && echo 2 > $h/pwm1_enable; done; true'
Restart=on-failure

[Install]
WantedBy=multi-user.target
