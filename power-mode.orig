#!/bin/sh
# Switch between TLP profiles: perf | save | auto | status
set -e
cpu=/sys/devices/system/cpu
case "$1" in
  perf) sudo tlp ac ;;
  save)
    sudo tlp bat
    [ "$(prime-select query 2>/dev/null)" = nvidia ] &&
      echo "Hint: NVIDIA GPU is always on. For battery run: sudo prime-select on-demand (then re-login)."
    ;;
  auto) sudo tlp start ;;
  status|"")
    echo "governor: $(cat $cpu/cpu0/cpufreq/scaling_governor)"
    echo "boost:    $(cat $cpu/cpufreq/boost)"
    echo "max freq: $(($(cat $cpu/cpu0/cpufreq/scaling_max_freq) / 1000)) MHz"
    echo "cur freq: $(awk '/MHz/{s+=$4;n++} END{printf "%d", s/n}' /proc/cpuinfo) MHz avg"
    echo "gpu mode: $(prime-select query 2>/dev/null || echo n/a)"
    b=/sys/class/power_supply/BAT0
    echo "battery:  $(cat $b/capacity)% $(cat $b/status), limit $(cat $b/charge_control_end_threshold)%, draw $(awk '{printf "%.1f", $1/1e6}' $b/power_now) W"
    ;;
  *) echo "usage: power-mode perf|save|auto|status"; exit 1 ;;
esac
